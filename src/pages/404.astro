---
import BaseLayout from "../layouts/BaseLayout.astro";
import Kite from "../components/Kite.astro";
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas se ha ido volando."
  noindex
>
  <section class="relative overflow-hidden">
    <div class="container-x flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
      <Kite class="h-40 w-28 text-gold/50" />
      <p class="eyebrow mt-8">Error 404</p>
      <h1 class="mt-4 max-w-lg text-5xl leading-[0.95] text-ink sm:text-6xl">
        Esta página se fue
        <span class="script text-[1.12em] text-gold">volando</span>
      </h1>
      <p class="mt-5 max-w-sm text-[0.95rem] text-ink-soft">
        Puede que el enlace esté mal escrito o que la página todavía no exista.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn btn-primary">Volver al inicio</a>
        <a href="/tienda" class="btn btn-outline">Ver la colección</a>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Star from "../components/Star.astro";
import Kite from "../components/Kite.astro";
import { enlaces } from "../data/site";

const faqs = [
  {
    id: "envios",
    pregunta: "¿Cómo serán los envíos?",
    respuesta:
      "Estamos cerrando las condiciones con la agencia. La idea es preparar cada pedido con papel de seda y enviarlo en 24-48 h desde la apertura.",
  },
  {
    id: "devoluciones",
    pregunta: "¿Y las devoluciones?",
    respuesta:
      "Queremos un cambio sencillo: 30 días desde la recepción, prenda sin usar y con etiqueta. Publicaremos el proceso completo al abrir.",
  },
  {
    id: "tallas",
    pregunta: "¿Cómo elijo la talla?",
    respuesta:
      "Cada ficha llevará medidas reales en centímetros. Si dudas entre dos tallas, escríbenos: te respondemos nosotras y te ayudamos a elegir.",
  },
  {
    id: "regalos",
    pregunta: "¿Preparáis regalos?",
    respuesta:
      "Sí. Podremos envolver el pedido y añadir una nota escrita a mano. De momento, dinos qué necesitas por correo y lo organizamos.",
  },
];
---

<BaseLayout
  title="Contacto"
  description="Escríbenos si tienes dudas sobre tallas, pedidos o la próxima apertura de COMETA. Boutique infantil de premamá, bebés y niños."
>
  <section class="relative overflow-hidden border-b border-gold/15">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute -left-24 -top-24 h-72 w-72 rounded-full bg-blush-soft/50 blur-3xl"></div>
      <div class="absolute right-0 top-0 h-72 w-72 rounded-full bg-gold-soft/20 blur-3xl"></div>
    </div>

    <div class="container-x relative grid items-end gap-10 py-16 lg:grid-cols-[1.15fr_0.85fr] lg:py-20">
      <div class="max-w-2xl">
        <p class="eyebrow flex items-center gap-3">
          <Star class="h-3 w-3 text-blush" />
          Hablemos
        </p>
        <h1 class="mt-5 text-5xl leading-[0.95] text-ink sm:text-6xl">
          Estamos al otro{" "}
          <span class="script text-[1.12em] text-gold">lado</span>
        </h1>
        <p class="mt-5 text-[0.98rem] leading-relaxed text-ink-soft">
          Dudas de talla, un regalo especial o simplemente curiosidad por la
          apertura. Escríbenos y te contestamos en menos de 48 horas.
        </p>
      </div>

      <div class="hidden justify-end lg:flex" aria-hidden="true">
        <Kite class="h-40 w-28 text-gold/30" />
      </div>
    </div>
  </section>

  <section class="py-14 lg:py-20">
    <div class="container-x grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20">
      <div>
        <h2 class="font-display text-3xl text-ink">Cuéntanos</h2>
        <p class="mt-2 text-[0.85rem] text-ink-soft">
          Los campos marcados con * son obligatorios.
        </p>

        <form id="contacto" class="mt-8 space-y-5" novalidate>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="nombre" class="mb-2 block text-[0.62rem] font-bold uppercase tracking-[0.18em] text-ink-soft">
                Nombre *
              </label>
              <input
                id="nombre"
                name="nombre"
                type="text"
                required
                autocomplete="name"
                class="w-full rounded-xl border border-gold/25 bg-cream-soft px-4 py-3 text-sm text-ink placeholder:text-ink-muted/60 focus:border-gold focus:outline-none"
                placeholder="Tu nombre"
              />
            </div>
            <div>
              <label for="email-contacto" class="mb-2 block text-[0.62rem] font-bold uppercase tracking-[0.18em] text-ink-soft">
                Correo *
              </label>
              <input
                id="email-contacto"
                name="email"
                type="email"
                required
                autocomplete="email"
                class="w-full rounded-xl border border-gold/25 bg-cream-soft px-4 py-3 text-sm text-ink placeholder:text-ink-muted/60 focus:border-gold focus:outline-none"
                placeholder="tu@correo.com"
              />
            </div>
          </div>

          <div>
            <label for="asunto" class="mb-2 block text-[0.62rem] font-bold uppercase tracking-[0.18em] text-ink-soft">
              Motivo
            </label>
            <select
              id="asunto"
              name="asunto"
              class="w-full appearance-none rounded-xl border border-gold/25 bg-cream-soft px-4 py-3 text-sm text-ink focus:border-gold focus:outline-none"
            >
              <option>Consulta sobre una prenda</option>
              <option>Tallas y medidas</option>
              <option>Pedido o regalo</option>
              <option>Prensa y colaboraciones</option>
              <option>Otra cosa</option>
            </select>
          </div>

          <div>
            <label for="mensaje" class="mb-2 block text-[0.62rem] font-bold uppercase tracking-[0.18em] text-ink-soft">
              Mensaje *
            </label>
            <textarea
              id="mensaje"
              name="mensaje"
              rows="6"
              required
              class="w-full resize-none rounded-xl border border-gold/25 bg-cream-soft px-4 py-3 text-sm text-ink placeholder:text-ink-muted/60 focus:border-gold focus:outline-none"
              placeholder="Cuéntanos qué necesitas"
            ></textarea>
          </div>

          <label class="flex items-start gap-3 text-[0.78rem] leading-relaxed text-ink-soft">
            <input
              type="checkbox"
              name="privacidad"
              required
              class="mt-1 h-4 w-4 rounded border-gold/40 accent-gold"
            />
            <span>
              He leído y acepto la{" "}
              <a href="/legal/privacidad" class="underline decoration-gold/50 underline-offset-2 hover:text-gold-deep">política de privacidad</a>.
            </span>
          </label>

          <button type="submit" class="btn btn-primary w-full sm:w-auto">
            Enviar mensaje
          </button>

          <p id="contacto-msg" role="status" class="min-h-5 text-[0.8rem] font-semibold text-gold-deep"></p>
        </form>
      </div>

      <aside class="space-y-5">
        <div class="rounded-[1.4rem] border border-gold/20 bg-cream-soft p-6">
          <h2 class="text-[0.62rem] font-bold uppercase tracking-[0.22em] text-ink-muted">Correo</h2>
          <a href={`mailto:${enlaces.email}`} class="mt-3 inline-block font-display text-2xl text-ink hover:text-gold-deep">
            {enlaces.email}
          </a>
          <p class="mt-2 text-[0.75rem] text-ink-muted">Respondemos en 24-48 h laborables.</p>
        </div>

        <div class="rounded-[1.4rem] border border-gold/20 bg-cream-soft p-6">
          <h2 class="text-[0.62rem] font-bold uppercase tracking-[0.22em] text-ink-muted">Instagram</h2>
          <a href={enlaces.instagram} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex items-center gap-2 font-display text-2xl text-ink hover:text-gold-deep">
            @cometa
          </a>
          <p class="mt-2 text-[0.75rem] text-ink-muted">Novedades, telas y el día a día de la tienda.</p>
        </div>

        <div class="rounded-[1.4rem] border border-gold/20 bg-blush-soft/40 p-6">
          <h2 class="text-[0.62rem] font-bold uppercase tracking-[0.22em] text-ink-muted">Próxima apertura</h2>
          <p class="mt-3 font-display text-2xl leading-snug text-ink">
            Muy pronto, con la primera colección.
          </p>
          <p class="mt-2 text-[0.75rem] leading-relaxed text-ink-soft">
            Estamos preparando fotos, tallas y condiciones de envío. Deja tu correo en la portada y te avisamos.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section class="border-t border-gold/15 bg-cream-soft py-16">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Antes de escribir</p>
        <h2 class="mt-4 text-4xl text-ink">Preguntas frecuentes</h2>
      </div>

      <div class="mx-auto mt-10 max-w-2xl divide-y divide-gold/15 border-y border-gold/15">
        {faqs.map((faq) => (
          <details id={faq.id} class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-xl text-ink [&::-webkit-details-marker]:hidden">
              {faq.pregunta}
              <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full border border-gold/30 text-gold-deep transition-transform group-open:rotate-45">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
                </svg>
              </span>
            </summary>
            <p class="mt-3 pr-10 text-[0.9rem] leading-relaxed text-ink-soft">{faq.respuesta}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    const contacto = document.getElementById("contacto");
    const msg = document.getElementById("contacto-msg");

    contacto?.addEventListener("submit", (event) => {
      event.preventDefault();

      const datos = new FormData(contacto);
      const nombre = String(datos.get("nombre") || "").trim();
      const email = String(datos.get("email") || "").trim();
      const asunto = String(datos.get("asunto") || "Consulta");
      const mensaje = String(datos.get("mensaje") || "").trim();

      if (!nombre || !email.includes("@") || !mensaje) {
        msg.textContent = "Revisa los campos obligatorios, por favor.";
        return;
      }

      const cuerpo = encodeURIComponent(
        `${mensaje}\n\n— ${nombre}\n${email}`,
      );

      msg.textContent = "Abriendo tu aplicación de correo…";
      window.location.href = `mailto:hola@cometa.es?subject=${encodeURIComponent("[COMETA] " + asunto)}&body=${cuerpo}`;
    });
  </script>
</BaseLayout>

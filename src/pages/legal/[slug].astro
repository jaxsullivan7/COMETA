---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { paginasLegales } from "../../data/legal";

export function getStaticPaths() {
  return paginasLegales.map((pagina) => ({
    params: { slug: pagina.slug },
    props: { pagina },
  }));
}

const { pagina } = Astro.props;
---

<BaseLayout
  title={pagina.titulo}
  description={pagina.entradilla}
  noindex
>
  <section class="border-b border-gold/15">
    <div class="container-x py-14 lg:py-20">
      <nav aria-label="Migas de pan" class="text-[0.62rem] uppercase tracking-[0.2em] text-ink-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="transition-colors hover:text-gold-deep">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ink">{pagina.titulo}</li>
        </ol>
      </nav>

      <h1 class="mt-7 max-w-2xl text-4xl leading-[0.95] text-ink sm:text-6xl">
        {pagina.titulo}
      </h1>
      <p class="mt-4 max-w-xl text-[0.95rem] text-ink-soft">{pagina.entradilla}</p>
      <p class="mt-3 text-[0.62rem] uppercase tracking-[0.18em] text-ink-muted">
        Última actualización: {pagina.actualizado}
      </p>

      <p class="mt-6 inline-flex items-center gap-2 rounded-full border border-blush/40 bg-blush-soft/40 px-4 py-2 text-[0.65rem] font-semibold text-ink-soft">
        <span class="h-1.5 w-1.5 rounded-full bg-blush-deep"></span>
        Borrador pendiente de revisión legal y de completar los datos entre corchetes.
      </p>
    </div>
  </section>

  <section class="py-14 lg:py-20">
    <div class="container-x">
      <div class="max-w-3xl space-y-10">
        {pagina.secciones.map((seccion) => (
          <article>
            <h2 class="font-display text-2xl text-ink">{seccion.titulo}</h2>
            <div class="mt-3 space-y-4 text-[0.92rem] leading-relaxed text-ink-soft">
              {seccion.parrafos.map((parrafo) => <p>{parrafo}</p>)}
            </div>
          </article>
        ))}
      </div>

      <div class="mt-14 flex flex-wrap gap-3">
        <a href="/" class="btn btn-outline">Volver al inicio</a>
        <a href="/contacto" class="btn btn-primary">Contactar</a>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import Kite from "../components/Kite.astro";
import Star from "../components/Star.astro";
import { categorias, productos } from "../data/site";

const destacados = [
  productos[0],
  productos[2],
  productos[5],
  productos[6],
].filter(Boolean);

const valores = [
  {
    titulo: "Tejidos que respetan la piel",
    texto:
      "Algodón suave, costuras planas y etiquetas cuidadas para las pieles más sensibles.",
    icono: "leaf",
  },
  {
    titulo: "Diseñado para durar",
    texto:
      "Prendas que aguantan lavados, juegos y hermanos pequeños. Menos moda, más memoria.",
    icono: "heart",
  },
  {
    titulo: "Acompañamiento cercano",
    texto:
      "Te ayudamos con tallas y dudas por Instagram o correo. Como en la tienda de barrio.",
    icono: "chat",
  },
];
---

<BaseLayout
  title="COMETA · Boutique infantil de ropa para bebés, niños y premamá"
  description="COMETA es una boutique infantil con ropa para cada etapa de su historia: premamá, bebés de 0 a 36 meses y niños de 4 a 12 años. Próxima apertura."
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="absolute -left-32 top-0 h-96 w-96 rounded-full bg-blush-soft/60 blur-3xl"
      >
      </div>
      <div
        class="absolute -right-24 top-1/4 h-[28rem] w-[28rem] rounded-full bg-gold-soft/20 blur-3xl"
      >
      </div>
      <Kite
        class="absolute right-[4%] top-10 hidden h-44 w-32 text-gold/35 lg:block"
      />
    </div>

    <div class="container-x relative">
      <div
        class="grid items-center gap-10 pb-12 pt-10 sm:gap-14 sm:pb-16 sm:pt-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20 lg:pb-24 lg:pt-20"
      >
        <div class="reveal">
          <p class="eyebrow flex items-center gap-2.5 text-[0.6rem] tracking-[0.16em] sm:gap-3 sm:text-[0.7rem] sm:tracking-[0.24em]">
            <Star class="h-3 w-3 shrink-0 text-blush" />
            Boutique infantil · Próxima apertura
          </p>

          <h1
            class="mt-5 text-[2.65rem] leading-[0.95] text-ink sm:mt-6 sm:text-6xl lg:text-[4.4rem]"
          >
            Ropa para cada{" "}
            <em class="font-normal italic text-gold-deep">etapa</em>{" "}
            de su{" "}
            <span class="script text-[1.12em] text-gold">historia</span>.
          </h1>

          <p class="mt-7 max-w-md text-[0.98rem] leading-relaxed text-ink-soft">
            Prendas suaves y atemporales para el embarazo, los primeros meses y
            los años de correr sin parar. Una tienda nacida del cariño por los
            detalles pequeños.
          </p>

          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a href="/tienda" class="btn btn-primary">
              Descubrir la colección
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M5 12h14M13 6l6 6-6 6"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </a>
            <a href="/nosotras" class="btn btn-outline">Nuestra historia</a>
          </div>

          <ul
            class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 text-[0.62rem] font-semibold uppercase tracking-[0.16em] text-ink-muted"
          >
            <li class="flex items-center gap-2">
              <span class="h-1 w-1 rounded-full bg-gold"></span> Tejidos naturales
            </li>
            <li class="flex items-center gap-2">
              <span class="h-1 w-1 rounded-full bg-gold"></span> Envío cuidado
            </li>
            <li class="flex items-center gap-2">
              <span class="h-1 w-1 rounded-full bg-gold"></span> Atención cercana
            </li>
          </ul>
        </div>

        <div class="reveal relative mx-auto w-full max-w-[19rem] sm:max-w-[26rem]" style="--reveal-delay: 120ms">
          <div
            class="arch border border-gold/30 bg-blush-soft/70 p-2 shadow-soft sm:p-2.5"
          >
            <div class="arch bg-blush-soft">
              <img
                src="/brand/hero-premama.png"
                alt="Ilustración de una mujer embarazada con un vestido color melocotón sosteniendo su vientre"
                width="385"
                height="340"
                class="arch aspect-[5/6] w-full object-cover object-[62%_38%] mix-blend-multiply"
                fetchpriority="high"
              />
            </div>
          </div>

          <div
            class="absolute -bottom-5 -left-3 grid h-20 w-20 place-items-center rounded-full border border-gold/30 bg-cream text-center shadow-float sm:-bottom-6 sm:-left-8 sm:h-28 sm:w-28"
          >
            <div>
              <span class="script block text-lg text-gold sm:text-2xl">Cometa</span>
              <span
                class="mt-0.5 block text-[0.38rem] font-bold uppercase tracking-[0.16em] text-ink-soft sm:mt-1 sm:text-[0.45rem] sm:tracking-[0.2em]"
              >
                Hecho con cariño
              </span>
            </div>
          </div>

          <Star class="absolute -right-3 top-6 h-5 w-5 text-gold/70" />
          <Star class="absolute -left-6 top-1/3 h-3 w-3 text-blush" />
        </div>
      </div>
    </div>

    <div class="container-x">
      <div class="hairline"></div>
    </div>
  </section>

  <!-- Categorías -->
  <section class="py-14 lg:py-24" aria-labelledby="categorias-titulo">
    <div class="container-x">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div class="reveal max-w-xl">
          <p class="eyebrow">Tres etapas, un mismo cuidado</p>
          <h2 id="categorias-titulo" class="mt-4 text-3xl text-ink sm:text-5xl">
            Para cuando la vida{" "}
            <span class="script text-[1.1em] text-gold">crece</span>
          </h2>
        </div>
        <a href="/tienda" class="link-soft reveal shrink-0">
          Ver toda la colección
          <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M5 12h14M13 6l6 6-6 6"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <div
        class="no-scrollbar -mx-5 mt-10 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 md:mx-0 md:mt-12 md:grid md:grid-cols-3 md:gap-6 md:overflow-visible md:px-0 md:pb-0"
      >
        {categorias.map((categoria, index) => (
          <a
            href={`/tienda/${categoria.slug}`}
            class="card-lift reveal group w-[78%] min-w-[78%] shrink-0 snap-start overflow-hidden rounded-[1.5rem] border border-gold/15 bg-cream-soft p-4 md:w-auto md:min-w-0"
            style={`--reveal-delay: ${index * 90}ms`}
          >
            <div
              class={`relative h-52 overflow-hidden rounded-[1.1rem] md:h-60 ${categoria.tint}`}
            >
              <img
                src={categoria.imagen}
                alt={`Ilustración de ropa de ${categoria.nombre.toLowerCase()}`}
                width="610"
                height="265"
                loading="lazy"
                class="h-full w-full object-contain mix-blend-multiply transition-transform duration-700 ease-out group-hover:scale-[1.06]"
              />
              <span
                class="absolute bottom-3 left-3 rounded-full bg-cream/85 px-3 py-1 text-[0.52rem] font-bold uppercase tracking-[0.18em] text-gold-deep backdrop-blur"
              >
                {categoria.rango}
              </span>
            </div>

            <div class="mt-5 flex items-end justify-between px-1 pb-1">
              <h3 class="font-display text-[1.7rem] leading-none text-ink">
                {categoria.nombre}
              </h3>
              <span
                class="grid h-9 w-9 place-items-center rounded-full border border-gold/25 text-gold-deep transition-colors duration-300 group-hover:bg-gold group-hover:text-cream-soft"
                aria-hidden="true"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none">
                  <path
                    d="M5 12h14M13 6l6 6-6 6"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </span>
            </div>
            <p class="mt-3 px-1 pb-1 text-[0.85rem] leading-relaxed text-ink-soft">
              {categoria.descripcion}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Destacados -->
  <section class="bg-cream-deep/35 py-14 lg:py-24" aria-labelledby="destacados-titulo">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center reveal">
        <p class="eyebrow">Selección de la casa</p>
        <h2 id="destacados-titulo" class="mt-4 text-3xl text-ink sm:text-5xl">
          Piezas que ya nos{" "}
          <span class="script text-[1.12em] text-gold">enamoran</span>
        </h2>
        <p class="mt-5 text-[0.95rem] text-ink-soft">
          Una pequeña muestra de la primera colección. Las fotos reales y los
          precios llegarán con la apertura.
        </p>
      </div>

      <div class="mt-10 grid grid-cols-2 gap-4 sm:gap-5 lg:mt-12 lg:grid-cols-4">
        {destacados.map((producto, index) => (
          <div class="reveal" style={`--reveal-delay: ${index * 70}ms`}>
            <ProductCard producto={producto!} />
          </div>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a href="/tienda" class="btn btn-outline">Ver la colección completa</a>
      </div>
    </div>
  </section>

  <!-- Historia -->
  <section class="relative overflow-hidden py-14 lg:py-28" aria-labelledby="historia-titulo">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="absolute -left-40 bottom-0 h-96 w-96 rounded-full bg-sage-soft/50 blur-3xl"
      >
      </div>
    </div>

    <div class="container-x relative grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="reveal relative mx-auto w-full max-w-md">
        <div
          class="rotate-[-2deg] rounded-md border border-gold/20 bg-cream-soft p-3 shadow-float transition-transform duration-700 hover:rotate-0"
        >
          <img
            src="/brand/cartelera.jpg"
            alt="Cartelera de COMETA: Cometa, boutique infantil. Ropa para cada etapa de su historia. Premamá, bebés de 0 a 36 meses y niños de 4 a 12 años."
            width="1999"
            height="1244"
            loading="lazy"
            class="rounded-sm"
          />
        </div>
        <div
          class="absolute -right-4 -top-6 grid h-20 w-20 place-items-center rounded-full border border-gold/30 bg-cream shadow-soft"
          aria-hidden="true"
        >
          <span class="script text-lg text-gold">2026</span>
        </div>
      </div>

      <div class="reveal" style="--reveal-delay: 100ms">
        <p class="eyebrow">Nuestra historia</p>
        <h2 id="historia-titulo" class="mt-4 text-3xl text-ink sm:text-5xl">
          Nace <span class="script text-[1.15em] text-gold">Cometa</span>
        </h2>

        <div class="mt-6 space-y-5 text-[0.98rem] leading-relaxed text-ink-soft">
          <p>
            COMETA nace de una idea sencilla: vestir a los niños como lo que son,
            personas pequeñas con una historia enorme por delante.
          </p>
          <p>
            Cada prenda está pensada para acompañar una etapa concreta, desde la
            espera hasta los años de patio y merienda. Sin prisa, sin ruido y con
            la calidad que nos gustaría para nuestra propia familia.
          </p>
        </div>

        <blockquote class="mt-8 border-l border-gold/40 pl-5">
          <p class="font-display text-xl italic leading-snug text-ink">
            «Ropa para cada etapa de su historia.»
          </p>
          <footer
            class="mt-3 text-[0.62rem] font-bold uppercase tracking-[0.2em] text-ink-muted"
          >
            — Vanesa, fundadora de COMETA
          </footer>
        </blockquote>

        <a href="/nosotras" class="link-soft mt-9">Conoce el proyecto</a>
      </div>
    </div>
  </section>

  <!-- Valores -->
  <section class="border-y border-gold/15 bg-cream-soft py-12 lg:py-20">
    <div class="container-x grid gap-10 md:grid-cols-3">
      {valores.map((valor, index) => (
        <div class="reveal text-center md:text-left" style={`--reveal-delay: ${index * 80}ms`}>
          <span
            class="mx-auto grid h-11 w-11 place-items-center rounded-full border border-gold/30 text-gold-deep md:mx-0"
          >
            {valor.icono === "leaf" && (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M20 4c-8 0-14 4.5-14 11a5 5 0 0 0 5 5c6.5 0 9-6 9-16Z"
                  stroke="currentColor"
                  stroke-width="1.2"
                  stroke-linejoin="round"></path>
                <path d="M4 21c2-6 6-9 11-11" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path>
              </svg>
            )}
            {valor.icono === "heart" && (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M12 20s-7-4.3-7-9.3A3.7 3.7 0 0 1 12 8a3.7 3.7 0 0 1 7 2.7c0 5-7 9.3-7 9.3Z"
                  stroke="currentColor"
                  stroke-width="1.2"
                  stroke-linejoin="round"></path>
              </svg>
            )}
            {valor.icono === "chat" && (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M20 12a7.5 7.5 0 0 1-11 6.6L5 20l1.4-3.7A7.5 7.5 0 1 1 20 12Z"
                  stroke="currentColor"
                  stroke-width="1.2"
                  stroke-linejoin="round"></path>
                <path d="M9 11h6M9 14h4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path>
              </svg>
            )}
          </span>

          <h3 class="mt-5 font-display text-xl text-ink">{valor.titulo}</h3>
          <p class="mt-2 text-[0.85rem] leading-relaxed text-ink-soft">
            {valor.texto}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Newsletter -->
  <section class="py-14 lg:py-24">
    <div class="container-x">
      <div
        class="reveal relative overflow-hidden rounded-[2rem] border border-gold/20 bg-gradient-to-br from-blush-soft/70 via-cream to-sage-soft/60 px-5 py-10 text-center sm:px-12 sm:py-14"
      >
        <Star class="absolute left-8 top-8 h-4 w-4 text-gold/60" />
        <Star class="absolute bottom-10 right-10 h-5 w-5 text-blush/70" />
        <Kite class="absolute -right-6 -top-10 h-36 w-24 text-gold/20" />

        <p class="eyebrow">Sé la primera en saberlo</p>
        <h2 class="mx-auto mt-4 max-w-lg text-3xl text-ink sm:text-[2.9rem]">
          La primera colección está en{" "}
          <span class="script text-[1.1em] text-gold">camino</span>
        </h2>
        <p class="mx-auto mt-4 max-w-md text-[0.92rem] text-ink-soft">
          Déjanos tu correo y te avisaremos cuando COMETA abra sus puertas.
          Nada de spam: solo novedades bonitas.
        </p>

        <form
          id="newsletter"
          class="mx-auto mt-8 flex max-w-md flex-col gap-3 sm:flex-row"
          novalidate
        >
          <label for="email" class="sr-only">Correo electrónico</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="tu@correo.com"
            class="w-full rounded-full border border-gold/30 bg-cream/80 px-5 py-3.5 text-sm text-ink placeholder:text-ink-muted/70 focus:border-gold focus:outline-none"
          />
          <button type="submit" class="btn btn-primary shrink-0">
            Avísame
          </button>
        </form>

        <p
          id="newsletter-msg"
          role="status"
          class="mt-4 min-h-5 text-[0.8rem] font-semibold text-gold-deep"
        >
        </p>
        <p class="mt-2 text-[0.6rem] uppercase tracking-[0.18em] text-ink-muted">
          Sin spam · Baja cuando quieras
        </p>
      </div>
    </div>
  </section>

  <script is:inline>
    const form = document.getElementById("newsletter");
    const msg = document.getElementById("newsletter-msg");

    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const email = String(data.get("email") || "").trim();

      if (!email || !email.includes("@")) {
        msg.textContent = "Revisa tu correo, parece incompleto.";
        return;
      }

      msg.textContent = "Gracias. Te escribiremos en cuanto abramos.";
      form.reset();
    });
  </script>
</BaseLayout>

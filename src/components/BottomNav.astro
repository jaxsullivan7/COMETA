---
const path = Astro.url.pathname;

const items = [
  {
    label: "Inicio",
    href: "/",
    active: path === "/",
    icon: "home",
  },
  {
    label: "Tienda",
    href: "/tienda",
    active: path.startsWith("/tienda"),
    icon: "shop",
  },
  {
    label: "Contacto",
    href: "/contacto",
    active: path.startsWith("/contacto"),
    icon: "chat",
  },
] as const;
---

<nav
  aria-label="Navegación móvil"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-gold/20 bg-cream/95 pb-[env(safe-area-inset-bottom)] backdrop-blur-md lg:hidden"
>
  <ul class="grid grid-cols-4">
    {items.slice(0, 2).map((item) => (
      <li>
        <a
          href={item.href}
          class:list={[
            "flex h-[4.25rem] flex-col items-center justify-center gap-1 text-[0.55rem] font-semibold uppercase tracking-[0.14em] transition-colors",
            item.active ? "text-gold-deep" : "text-ink-soft active:text-gold-deep",
          ]}
          aria-current={item.active ? "page" : undefined}
        >
          <span class:list={["relative flex h-6 w-6 items-center justify-center", item.active && "text-gold-deep"]}>
            {item.icon === "home" && (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1v-9.5Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
              </svg>
            )}
            {item.icon === "shop" && (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M4 12.2V5a1 1 0 0 1 1-1h7.2l7.3 7.3-8.2 8.2L4 12.2Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                <circle cx="9" cy="9" r="1.3" stroke="currentColor" stroke-width="1.2" />
              </svg>
            )}
            {item.active && (
              <span class="absolute -bottom-1.5 h-1 w-1 rounded-full bg-gold" aria-hidden="true"></span>
            )}
          </span>
          <span>{item.label}</span>
        </a>
      </li>
    ))}

    <li>
      <button
        type="button"
        data-cart-open
        class="flex h-[4.25rem] w-full flex-col items-center justify-center gap-1 text-[0.55rem] font-semibold uppercase tracking-[0.14em] text-ink-soft transition-colors active:text-gold-deep"
        aria-label="Abrir la cesta"
      >
        <span class="relative flex h-6 w-6 items-center justify-center">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 8h12l-1 11H7L6 8Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
            <path d="M9 8V6.5a3 3 0 0 1 6 0V8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
          </svg>
          <span
            data-cart-count
            hidden
            class="absolute -right-2 -top-1.5 grid h-4 min-w-4 place-items-center rounded-full bg-gold px-1 text-[0.5rem] font-bold leading-none text-cream-soft"
          >
            0
          </span>
        </span>
        <span>Cesta</span>
      </button>
    </li>

    <li>
      <a
        href={items[2].href}
        class:list={[
          "flex h-[4.25rem] flex-col items-center justify-center gap-1 text-[0.55rem] font-semibold uppercase tracking-[0.14em] transition-colors",
          items[2].active ? "text-gold-deep" : "text-ink-soft active:text-gold-deep",
        ]}
        aria-current={items[2].active ? "page" : undefined}
      >
        <span class="relative flex h-6 w-6 items-center justify-center">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M20 12a7.5 7.5 0 0 1-11 6.6L5 20l1.4-3.7A7.5 7.5 0 1 1 20 12Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
            <path d="M9 11h6M9 14h4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
          </svg>
          {items[2].active && (
            <span class="absolute -bottom-1.5 h-1 w-1 rounded-full bg-gold" aria-hidden="true"></span>
          )}
        </span>
        <span>Contacto</span>
      </a>
    </li>
  </ul>
</nav>

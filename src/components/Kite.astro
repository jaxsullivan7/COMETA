---
interface Props {
  class?: string;
  flip?: boolean;
}

const { class: className = "", flip = false } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 220 300"
  fill="none"
  aria-hidden="true"
  style={flip ? "transform: scaleX(-1)" : undefined}
>
  <g stroke="currentColor" stroke-width="1.1" stroke-linecap="round">
    <path d="M110 14 168 72 110 130 52 72Z" />
    <path d="M110 14v116M52 72h116" opacity="0.6" />
    <path d="M110 130c14 18 6 32 18 44s24 20 18 38" opacity="0.85" />
  </g>
  <g fill="currentColor" opacity="0.9">
    <path d="M128 174c-6-4-10-2-10 4s6 8 10 4c4 4 10 2 10-4s-4-8-10-4Z" opacity="0.5" />
    <path d="M146 218c-6-4-10-2-10 4s6 8 10 4c4 4 10 2 10-4s-4-8-10-4Z" opacity="0.5" />
  </g>
</svg>

---
import { productos, preciosProvisionales } from "../data/site";
---

<div
  id="cart-overlay"
  class="fixed inset-0 z-[70] bg-ink/35 opacity-0 backdrop-blur-[2px] transition-opacity duration-300"
  data-cart-close
  aria-hidden="true"
  hidden
>
</div>

<aside
  id="cart-drawer"
  class="fixed inset-y-0 right-0 z-[71] flex w-full max-w-[26rem] translate-x-full flex-col bg-cream shadow-float transition-transform duration-500 ease-[cubic-bezier(.22,1,.36,1)]"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cart-title"
  aria-hidden="true"
  inert
>
  <header class="flex items-start justify-between border-b border-gold/15 px-5 py-5">
    <div>
      <p class="eyebrow">Tu selección</p>
      <h2 id="cart-title" class="mt-1 font-display text-3xl leading-none text-ink">
        La cesta
      </h2>
      <p
        id="cart-status"
        class="mt-2 text-[0.58rem] font-semibold uppercase tracking-[0.18em] text-ink-muted"
        aria-live="polite"
      >
        Cesta vacía
      </p>
    </div>

    <button
      id="cart-close"
      type="button"
      class="grid h-9 w-9 place-items-center rounded-full border border-gold/25 text-ink transition-colors hover:border-gold hover:text-gold-deep"
      aria-label="Cerrar la cesta"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
      </svg>
    </button>
  </header>

  <div class="flex-1 overflow-y-auto px-5">
    <!-- Vista 1: cesta -->
    <div id="cart-view" class="h-full">
      <ul id="cart-items" class="h-full"></ul>
    </div>

    <!-- Vista 2: datos del pedido -->
    <div id="checkout-view" class="py-5" hidden>
      <button
        type="button"
        data-checkout-back
        class="inline-flex items-center gap-2 text-[0.58rem] font-bold uppercase tracking-[0.18em] text-gold-deep transition-colors hover:text-ink"
      >
        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        Volver a la cesta
      </button>

      <p class="mt-4 text-[0.82rem] leading-relaxed text-ink-soft">
        Déjanos tus datos para preparar el pedido. Te confirmamos talla, envío y
        forma de pago por el mismo canal.
      </p>

      <div
        id="checkout-summary"
        class="mt-4 rounded-xl border border-gold/15 bg-cream-soft px-4 py-3"
      >
      </div>

      <form id="checkout-form" class="mt-5 space-y-4" novalidate>
        <div>
          <label
            for="ck-nombre"
            class="mb-1.5 block text-[0.56rem] font-bold uppercase tracking-[0.18em] text-ink-soft"
          >
            Nombre y apellidos *
          </label>
          <input
            id="ck-nombre"
            name="nombre"
            type="text"
            required
            autocomplete="name"
            aria-describedby="err-nombre"
            class="w-full rounded-xl border border-gold/25 bg-cream-soft px-4 py-2.5 text-sm text-ink placeholder:text-ink-muted/60 focus:border-gold focus:outline-none"
            placeholder="Ana García"
          />
          <p id="err-nombre" data-error="nombre" class="mt-1 hidden text-[0.68rem] font-semibold text-blush-deep"></p>
        </div>

        <div>
          <label
            for="ck-telefono"
            class="mb-1.5 block text-[0.56rem] font-bold uppercase tracking-[0.18em] text-ink-soft"
          >
            Teléfono *
          </label>
          <input
            id="ck-telefono"
            name="telefono"
            type="tel"
            required
            autocomplete="tel"
            inputmode="tel"
            aria-describedby="err-telefono"
            class="w-full rounded-xl border border-gold/25 bg-cream-soft px-4 py-2.5 text-sm text-ink placeholder:text-ink-muted/60 focus:border-gold focus:outline-none"
            placeholder="612 345 678"
          />
          <p id="err-telefono" data-error="telefono" class="mt-1 hidden text-[0.68rem] font-semibold text-blush-deep"></p>
        </div>

        <div>
          <label
            for="ck-email"
            class="mb-1.5 block text-[0.56rem] font-bold uppercase tracking-[0.18em] text-ink-soft"
          >
            Correo <span class="normal-case tracking-normal text-ink-muted">(opcional)</span>
          </label>
          <input
            id="ck-email"
            name="email"
            type="email"
            autocomplete="email"
            aria-describedby="err-email"
            class="w-full rounded-xl border border-gold/25 bg-cream-soft px-4 py-2.5 text-sm text-ink placeholder:text-ink-muted/60 focus:border-gold focus:outline-none"
            placeholder="ana@correo.com"
          />
          <p id="err-email" data-error="email" class="mt-1 hidden text-[0.68rem] font-semibold text-blush-deep"></p>
        </div>

        <div>
          <label
            for="ck-notas"
            class="mb-1.5 block text-[0.56rem] font-bold uppercase tracking-[0.18em] text-ink-soft"
          >
            Notas <span class="normal-case tracking-normal text-ink-muted">(opcional)</span>
          </label>
          <textarea
            id="ck-notas"
            name="notas"
            rows="3"
            class="w-full resize-none rounded-xl border border-gold/25 bg-cream-soft px-4 py-2.5 text-sm text-ink placeholder:text-ink-muted/60 focus:border-gold focus:outline-none"
            placeholder="Talla, dedicatoria, fecha en la que lo necesitas…"
          ></textarea>
        </div>

        <div>
          <label class="flex items-start gap-2.5 text-[0.75rem] leading-relaxed text-ink-soft">
            <input
              id="ck-privacidad"
              type="checkbox"
              name="privacidad"
              class="mt-1 h-4 w-4 shrink-0 rounded border-gold/40 accent-gold"
            />
            <span>
              He leído y acepto la{" "}
              <a
                href="/legal/privacidad"
                target="_blank"
                rel="noopener noreferrer"
                class="underline decoration-gold/50 underline-offset-2 hover:text-gold-deep"
                >política de privacidad</a
              >.
            </span>
          </label>
          <p id="err-privacidad" data-error="privacidad" class="mt-1 hidden text-[0.68rem] font-semibold text-blush-deep"></p>
        </div>
      </form>
    </div>
  </div>

  <footer class="border-t border-gold/15 bg-cream-soft px-5 py-5">
    <div class="flex items-baseline justify-between">
      <span class="text-[0.6rem] font-bold uppercase tracking-[0.2em] text-ink-soft">Total</span>
      <span id="cart-total" class="font-display text-2xl text-ink">0,00 €</span>
    </div>

    {preciosProvisionales && (
      <p data-aviso-precios hidden class="mt-1 text-[0.65rem] text-ink-muted">
        Precios orientativos pendientes de confirmar.
      </p>
    )}

    <p class="mt-1 text-[0.65rem] leading-relaxed text-ink-muted">
      El envío y las tallas se confirman al preparar el pedido.
    </p>

    <div id="cart-actions" class="mt-4 flex flex-col gap-2">
      <button id="cart-continue" type="button" class="btn btn-primary w-full">
        Continuar con el pedido
      </button>

      <button
        data-cart-clear
        type="button"
        class="mt-1 text-[0.58rem] font-semibold uppercase tracking-[0.18em] text-ink-muted underline-offset-4 transition-colors hover:text-gold-deep hover:underline"
        hidden
      >
        Vaciar cesta
      </button>
    </div>

    <div id="checkout-actions" class="mt-4 flex flex-col gap-2" hidden>
      <button
        type="submit"
        form="checkout-form"
        id="checkout-submit"
        class="btn btn-primary w-full"
      >
        Enviar pedido por WhatsApp
      </button>

      <a data-cart-mail href="#" class="btn btn-outline w-full">
        Enviar por correo
      </a>

      <p id="checkout-hint" class="text-center text-[0.6rem] leading-relaxed text-ink-muted" hidden>
        Sin número de WhatsApp configurado: copiaremos el pedido para que puedas
        pegarlo en un correo.
      </p>
    </div>

    <p
      id="cart-msg"
      role="status"
      class="mt-2 min-h-4 text-center text-[0.7rem] font-semibold text-gold-deep"
    >
    </p>
  </footer>
</aside>

<script
  type="application/json"
  id="cometa-productos"
  set:html={JSON.stringify(
    productos.map(({ id, nombre, categoria, precio }) => ({
      id,
      nombre,
      categoria,
      precio,
    })),
  )}
/>

<script>
  import "../scripts/cart.js";
</script>

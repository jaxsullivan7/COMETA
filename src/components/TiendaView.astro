---
import ProductCard from "./ProductCard.astro";
import Kite from "./Kite.astro";
import Star from "./Star.astro";
import { categorias, productos, type Categoria } from "../data/site";

interface Props {
  categoriaActiva?: Categoria;
  titulo: string;
  entradilla: string;
  descripcion: string;
}

const { categoriaActiva, titulo, entradilla, descripcion } = Astro.props;

const filtrados = categoriaActiva
  ? productos.filter((p) => p.categoria === categoriaActiva)
  : productos;

const activa = categorias.find((c) => c.slug === categoriaActiva);

const filtros = [
  { texto: "Todo", href: "/tienda", slug: undefined as Categoria | undefined },
  ...categorias.map((c) => ({
    texto: c.nombre,
    href: `/tienda/${c.slug}`,
    slug: c.slug as Categoria | undefined,
  })),
];
---

<section class="relative overflow-hidden border-b border-gold/15">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -left-32 -top-24 h-80 w-80 rounded-full bg-blush-soft/50 blur-3xl"></div>
    <div class="absolute -right-24 top-0 h-72 w-72 rounded-full bg-gold-soft/20 blur-3xl"></div>
  </div>

  <div class="container-x relative py-14 lg:py-20">
    <nav aria-label="Migas de pan" class="text-[0.62rem] uppercase tracking-[0.2em] text-ink-muted">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="transition-colors hover:text-gold-deep">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/tienda" class="transition-colors hover:text-gold-deep">Tienda</a>
        </li>
        {activa && (
          <>
            <li aria-hidden="true">/</li>
            <li class="text-ink">{activa.nombre}</li>
          </>
        )}
      </ol>
    </nav>

    <div class="mt-8 grid items-end gap-8 lg:grid-cols-[1.15fr_0.85fr]">
      <div>
        <p class="eyebrow flex items-center gap-3">
          <Star class="h-3 w-3 text-blush" />
          {entradilla}
        </p>
        <h1 class="mt-4 text-5xl leading-[0.95] text-ink sm:text-6xl">
          {titulo}
        </h1>
        <p class="mt-5 max-w-xl text-[0.98rem] leading-relaxed text-ink-soft">
          {descripcion}
        </p>
      </div>

      <div class="hidden justify-end lg:flex" aria-hidden="true">
        <Kite class="h-40 w-28 text-gold/30" />
      </div>
    </div>
  </div>
</section>

<section class="py-12 lg:py-16">
  <div class="container-x">
    <div class="flex flex-wrap items-center gap-2">
      {filtros.map((filtro) => {
        const activo = filtro.slug === categoriaActiva;
        return (
          <a
            href={filtro.href}
            class:list={[
              "rounded-full border px-5 py-2.5 text-[0.68rem] font-bold uppercase tracking-[0.16em] transition-colors",
              activo
                ? "border-gold bg-gold text-cream-soft"
                : "border-gold/25 bg-cream-soft text-ink-soft hover:border-gold/60 hover:text-ink",
            ]}
            aria-current={activo ? "page" : undefined}
          >
            {filtro.texto}
          </a>
        );
      })}
    </div>

    <div class="mt-6 flex items-center justify-between text-[0.62rem] uppercase tracking-[0.18em] text-ink-muted">
      <p>{filtrados.length} piezas en preparación</p>
      <p class="hidden sm:block">Precios y fotos al abrir la tienda</p>
    </div>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {filtrados.map((producto, index) => (
        <div class="reveal" style={`--reveal-delay: ${(index % 4) * 60}ms`}>
          <ProductCard producto={producto} />
        </div>
      ))}
    </div>

    <div
      class="mt-14 rounded-[1.5rem] border border-dashed border-gold/35 bg-cream-soft px-6 py-10 text-center"
    >
      <p class="eyebrow">Muy pronto</p>
      <h2 class="mt-3 font-display text-2xl text-ink">
        Estamos fotografiando y midiendo cada prenda
      </h2>
      <p class="mx-auto mt-3 max-w-lg text-[0.9rem] leading-relaxed text-ink-soft">
        Cuando la tienda abra, aquí encontrarás tallas, precios, composición y
        fotos reales de cada pieza. Mientras tanto, puedes escribirnos y te
        contamos lo que está por llegar.
      </p>
      <a href="/contacto" class="btn btn-outline mt-6">Habla con nosotros</a>
    </div>
  </div>
</section>

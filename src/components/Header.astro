---
import { navegacion, enlaces } from "../data/site";

const path = Astro.url.pathname;
const esActiva = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<div class="bg-ink text-cream/80">
  <div
    class="container-x flex items-center justify-center gap-3 py-2.5 text-[0.6rem] font-semibold uppercase tracking-[0.28em]"
  >
    <span class="hidden sm:inline">Próxima apertura</span>
    <span class="hidden h-1 w-1 rounded-full bg-gold sm:inline-block"></span>
    <span>Primera colección en camino</span>
  </div>
</div>

<header class="sticky top-0 z-40 border-b border-gold/15 bg-cream/90 backdrop-blur-md">
  <div class="container-x">
    <!-- Escritorio -->
    <div class="hidden items-center py-4 lg:grid lg:grid-cols-[1fr_auto_1fr]">
      <nav aria-label="Categorías" class="flex items-center gap-8">
        {navegacion.slice(0, 3).map((enlace) => (
          <a
            href={enlace.href}
            class="nav-link"
            aria-current={esActiva(enlace.href) ? "page" : undefined}
          >
            {enlace.texto}
          </a>
        ))}
      </nav>

      <a href="/" class="group flex flex-col items-center leading-none" aria-label="COMETA, inicio">
        <span
          class="script text-[2.7rem] text-gold transition-colors duration-300 group-hover:text-gold-deep"
        >
          Cometa
        </span>
        <span
          class="mt-1 flex items-center gap-2 text-[0.5rem] font-semibold uppercase tracking-[0.32em] text-ink-soft"
        >
          <span class="h-px w-5 bg-gold/50"></span>
          Boutique infantil
          <span class="h-px w-5 bg-gold/50"></span>
        </span>
      </a>

      <div class="flex items-center justify-end gap-8">
        {navegacion.slice(3).map((enlace) => (
          <a
            href={enlace.href}
            class="nav-link"
            aria-current={esActiva(enlace.href) ? "page" : undefined}
          >
            {enlace.texto}
          </a>
        ))}
        <a
          href={enlaces.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="text-ink-soft transition-colors hover:text-gold-deep"
          aria-label="COMETA en Instagram"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3.5" y="3.5" width="17" height="17" rx="5" stroke="currentColor" stroke-width="1.3"></rect>
            <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.3"></circle>
            <circle cx="17.2" cy="6.8" r="1" fill="currentColor"></circle>
          </svg>
        </a>
      </div>
    </div>

    <!-- Móvil -->
    <div class="flex items-center justify-between py-3 lg:hidden">
      <a href="/" class="flex flex-col leading-none" aria-label="COMETA, inicio">
        <span class="script text-[2.1rem] text-gold">Cometa</span>
        <span
          class="mt-0.5 flex items-center gap-1.5 text-[0.42rem] font-semibold uppercase tracking-[0.3em] text-ink-soft"
        >
          <span class="h-px w-3.5 bg-gold/50"></span>
          Boutique infantil
          <span class="h-px w-3.5 bg-gold/50"></span>
        </span>
      </a>

      <div class="flex items-center gap-2">
        <a
          href={enlaces.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="grid h-10 w-10 place-items-center text-ink-soft"
          aria-label="COMETA en Instagram"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3.5" y="3.5" width="17" height="17" rx="5" stroke="currentColor" stroke-width="1.3"></rect>
            <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.3"></circle>
            <circle cx="17.2" cy="6.8" r="1" fill="currentColor"></circle>
          </svg>
        </a>
        <button
          id="menu-toggle"
          type="button"
          class="grid h-10 w-10 place-items-center rounded-full border border-gold/30 text-ink"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <span class="sr-only">Abrir menú</span>
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 8h16M4 16h16" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<div
  id="mobile-menu"
  class="fixed inset-0 z-50 flex-col bg-cream opacity-0 transition-opacity duration-300 lg:hidden"
  hidden
>
  <div class="flex items-center justify-between border-b border-gold/15 px-5 py-3">
    <span class="script text-[2.1rem] text-gold">Cometa</span>
    <button
      id="menu-close"
      type="button"
      class="grid h-10 w-10 place-items-center rounded-full border border-gold/30 text-ink"
    >
      <span class="sr-only">Cerrar menú</span>
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <nav aria-label="Menú principal" class="flex flex-1 flex-col justify-center gap-1 px-8">
    {navegacion.map((enlace) => (
      <a
        href={enlace.href}
        class="border-b border-gold/10 py-4 font-display text-3xl text-ink"
        aria-current={esActiva(enlace.href) ? "page" : undefined}
      >
        {enlace.texto}
      </a>
    ))}
    <a
      href="/tienda"
      class="mt-6 inline-flex items-center justify-center rounded-full bg-gold px-6 py-3 text-[0.7rem] font-bold uppercase tracking-[0.2em] text-cream-soft"
    >
      Ver la colección
    </a>
  </nav>

  <div class="px-8 pb-8 pt-6 text-[0.68rem] uppercase tracking-[0.22em] text-ink-muted">
    <p>Próxima apertura · {new Date().getFullYear()}</p>
  </div>
</div>

<script is:inline>
  const toggle = document.getElementById("menu-toggle");
  const closeBtn = document.getElementById("menu-close");
  const menu = document.getElementById("mobile-menu");

  const abrir = () => {
    menu.hidden = false;
    requestAnimationFrame(() => menu.classList.add("opacity-100"));
    document.body.style.overflow = "hidden";
    toggle.setAttribute("aria-expanded", "true");
    closeBtn.focus();
  };

  const cerrar = () => {
    menu.classList.remove("opacity-100");
    document.body.style.overflow = "";
    toggle.setAttribute("aria-expanded", "false");
    setTimeout(() => {
      menu.hidden = true;
    }, 250);
    toggle.focus();
  };

  toggle?.addEventListener("click", abrir);
  closeBtn?.addEventListener("click", cerrar);
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !menu.hidden) cerrar();
  });
</script>
